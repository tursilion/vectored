; crt0 for main program - bank 1

; ---------------------------------------------------------------------------
; define linker rom section

	.bank rom(BASE=0x0000,SIZE=0xC000,FSFX=_rom)
	.area .cartridge		(BANK=rom)
	.area .bootloader		(CSEG,BANK=rom)
	.area .bankswitch.data	(DSEG,BANK=rom)
	.area .bankswitch.code	(CSEG,BANK=rom)
	.area .text  			(BANK=rom)
	.area .text.hot		    (BANK=rom)
	.area .text.unlikely	(BANK=rom)
	.area .text.unlikely	(BANK=rom)
	.area .text.last		(BANK=rom)

; ---------------------------------------------------------------------------
; define linker ram section (original size of 0x36B steps on BIOS reserved...?)

	.bank ram(BASE=0xc880,SIZE=0x036b,FSFX=_ram)
	.area .data  (BANK=ram)
	.area .bss   (BANK=ram)

; ---------------------------------------------------------------------------
; c runtime startup code
; ---------------------------------------------------------------------------
; initialize data segment (and zero bss segment in system ram),	
; then loop through main, error code > 0 causes cold reset

; Put some labels into the symbol table
        .globl _crt0_reboot
        .globl _tramp_return0
        .globl _wrap_StartSong
        .globl _wrap_StopSong
        .globl _wrap_SongLoop

		.area .bootloader			 

_crt0_init_data:				
		ldu		#s_.text			
		leau	l_.text,u			
		leau	l_.text.hot,u		
		leau	l_.text.unlikely,u	
		ldy		#s_.data			
		ldx		#l_.data			
		beq		_crt0_startup		

_crt0_copy_data:				
		lda		,u+					
		sta		,y+					
		leax	-1,x				
		bne		_crt0_copy_data		

_crt0_init_bss:				
		ldy		#s_.bss				
		ldx		#l_.bss				
		beq		_crt0_startup		
_crt0_zero_bss:				
		clr		,y+					
		leax	-1,x				
		bne		_crt0_zero_bss		

; Nobody seems to do their own stack, relying on the BIOS setup instead
; But, I need to ;)
; Default stack address is CBEA. But Super Space Acer cheats and stores some
; stuff above the stack for persistence across restarts. It's not clear whether
; I should also clean out the BIOS variables, but I expect they'll be okay since
; we don't reset mid-operation.

; cbea default top of stack for games
; cbe8 2 bytes for saved return for wrapper functions (this file)
; cb98 80 bytes for music player data
; cb97 1 byte for SAVEDCHECK1
; cb96 1 byte for SAVEDCHECK2
; cb8f 7 bytes for SAVEDSCORE
; cb8e 1 byte for SAVEDMODE 
; cb8d 1 byte for SAVEDATTRACT

_crt0_startup:
        lds     #0xcb8d
		jsr		_main				
_crt0_reboot:                       ; if we return, or restart vector from the game
		jmp 	_crt0_init_data		; go reinit ourselves

; here's a small trampoline area that must be copied to both banks as well
; uses the PB6 bank switching method. Because Port B is used by so much of
; the hardware, and the BIOS always writes PB6 as 0, it is cleaner to change
; the state by transitioning the pin between output (when it will be 0) and
; input (when it will pull up to 1). Since the rest of the direction bits
; on port B are fixed, this should work.
; There's a warning about some bad VIA6522s breaking in this method thanks
; to many functions in the BIOS using INC, which may read back bad values,
; but it doesn't look like many people are deterred from using it, and may
; only be faulty VIAs causing this...?? Since only some do it, maybe.

; We don't need to worry about clobbering 'a', and 'b' contains an argument and return
; We are also allowed to clobber 'x', but not Y or U.

; ***************************************************************************
; Switches to main bank (bank1), then returns
; To switch to bank 1, we want PB6 to go high. Since it's not safe to
; just output a 1 and hope for the best, we switch it to input mode
; where the VIA's pullup will take care of the electrical. No need to
; write any data. Remember the switch is instantaneous, this code must
; be the same in both banks.
_tramp_return1:
    lda  #0x9f       ; vectrex default value for port B with PB6 as input
    sta 0xD002       ; DDRB - bank switch happens here
    rts

; ***************************************************************************
; Switches to alt bank (bank0), then returns
; To switch to bank 0 we need to output a 0 on PB6. Since we are in input
; mode otherwise, and any previous write might affect our output, we will 
; do a slightly slower but potentially safer RMW for data. However, if the BIOS really
; does ever write a '1' to PB6, we may be screwed anyway. I'm still not sure
; how worried about that case to actually be...
; John's original notes also mess with Port A, Auxiliary control, and even the timer.
; I'm not sure why... not doing that here if I don't need to. Bank switch is supposed
; to be FAST. Seems like Aklabeth gets away with a simpler one similar to this, but they
; write ORB AFTER changing direction, which could cause the line to bounce.
_tramp_return0:
    lda #0x01        ; should we read/mask/write? Seems most people just 0x01. Seems safe though.
    sta 0xd000       ; PORTB - write it out - should be no change to output yet (ramp on, mux off)
    lda #0xdf        ; now we need to set DDRB
    sta 0xd002       ; DDRB - PB6 is now output, should output the zero we already wrote
    rts

; ***************************************************************************
; Switches to alt bank (bank0), then calls ay_StartSong. Note that the
; signature here takes a bank index rather than pointer, since only the
; other bank knows where the data files are located. There are only two
; and it is only at song start, not a big cost to look up.
; The second argument is stored on the stack (the first is in B), so we need to
; remove the extra JSR return address to have it in the right place.
; we probably also could have pulled it and re-pushed it in the right place... 
_wrap_StartSong:
    jsr _tramp_return0
    puls x                      ; pull the return value
    stx 0xcbe8                  ; save it - now our stack will look right when we jsr
    ;jsr _ay_StartSong          ; for music bank 0 only
    jmp _wrap_StartSong0        ; if we didn't bank, take up the same space
_wrap_StartSong0:
    ldx 0xcbe8                  ; get our return value back
    pshs x                      ; put it back on the stack
    jmp _tramp_return1

; ***************************************************************************
; Switches to alt bank (bank0), then calls ay_StopSong
; we have no arguments on the stack, we probably don't need the return address manip...
_wrap_StopSong:
    jsr _tramp_return0
    ;jsr _ay_StopSong           ; for music bank 0 only
    jmp _wrap_StopSong0         ; if we didn't bank, take up the same space
_wrap_StopSong0:
    jmp _tramp_return1

; ***************************************************************************
; Switches to alternate bank (bank0), then run ay_SongLoop on the other bank.
; note the rts - if the bank doesn't switch, it doesn't break, just no music
; we have no arguments on the stack, we probably don't need the return address manip...
_wrap_SongLoop:
    jsr _tramp_return0
    ;jsr _ay_SongLoop           ; for music bank 0 only
    jmp _wrap_SongLoop0
_wrap_SongLoop0:
    jmp _tramp_return1

; ***************************************************************************
; Original notes follow...
; ***************************************************************************

; The vectrex memory map
;
; 0000 - 7FFF      Cart ROM
; 8000 - C7FF      unused
; C800 - CFFF      1k RAM (duplicated every 0x400 bytes)
;                  C800-C87F - used by BIOS
;                  C880-CBE9 - Free RAM for application
;                  CBEA-CBFE - used by BIOS (is it?)
; D000 - D7FF      VIA (duplicated every 16 bytes)
;                  D000 - 8 bit port B (CNTRL) Not sure about the bit order
;                  D001 - 8 bit port A (DAC and PSC)
;                  D002 - Port B direction (0 = input)
;                  D003 - Port A direction (0 = input)
;                  D004-D007 - Timer 1 (T1LOLC, T1HOC, T1LOL, T1HOL)
;                  D008-D009 - Timer 2 (T2LOLC, T2HOC)
;                  D00A - Shift register
;                  D00B - Auxiliary Control
;                  D00C - Peripheral Control
;                  D00D - Interrupt Flag
;                  D00E - Interrupt Enable
;                  D00F - ORA
; D800 - DFFF      broken mapping don't use (selects RAM and VIA at the same time)
; E000 - FFFF      8k boot ROM
;                  E000-EFFF - Minestorm
;                  F000-FFFF - BIOS

